{
  "name": "copy-title-url",
  "version": "0.1.0",
  "description": "Copy the title and URL of the current page, formatted per site with configurable rules.",
  "license": "MIT",
  "author": "jsoizo",
  "homepage": "https://github.com/jsoizo/copy-title-url#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsoizo/copy-title-url.git"
  },
  "bugs": {
    "url": "https://github.com/jsoizo/copy-title-url/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "check": "wxt prepare && tsc --noEmit",
    "schema": "node scripts/generate-schema.ts",
    "icons": "for size in 16 32 48 128; do rsvg-convert -w $size -h $size assets/icon.svg -o public/icon/$size.png; done"
  },
  "dependencies": {
    "preact": "11.0.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.19.2",
    "@valibot/to-json-schema": "1.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
